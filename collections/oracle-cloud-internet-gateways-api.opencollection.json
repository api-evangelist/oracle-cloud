            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://iaas.{region}.oraclecloud.com/20160918/internetGateways",
            "params": [
              {
                "name": "compartmentId",
                "value": "ocid1.resource.oc1.iad.abcdefg123456",
                "type": "query",
                "description": "The OCID of the compartment."
              },
              {
                "name": "vcnId",
                "value": "ocid1.resource.oc1.iad.abcdefg123456",
                "type": "query",
                "description": "The OCID of the VCN."
              }
            ]
          },
          "docs": "Lists the internet gateways in the specified VCN and compartment."
        },
        {
          "info": {
            "name": "Oracle Cloud Create Internet Gateway",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://iaas.{region}.oraclecloud.com/20160918/internetGateways",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new internet gateway for the specified VCN."
        }
      ]
    }
  ],
  "bundled": true
