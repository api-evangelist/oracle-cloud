{
  "opencollection": "1.0.0",
  "info": {
    "name": "Oracle Cloud Compute Alarms DB Systems API",
    "version": "20160918"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "DB Systems",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Oracle Cloud List DB Systems",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://iaas.{region}.oraclecloud.com/20160918/dbSystems",
            "params": [
              {
                "name": "compartmentId",
                "value": "ocid1.resource.oc1.iad.abcdefg123456",
                "type": "query",
                "description": "The OCID of the compartment."
              },
              {
                "name": "limit",
                "value": "1",
                "type": "query",
                "description": "Maximum number of items to return."
              }
            ]
          },
          "docs": "Gets a list of DB systems in the specified compartment."
        },
        {
          "info": {
            "name": "Oracle Cloud Get DB System",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://iaas.{region}.oraclecloud.com/20160918/dbSystems/:dbSystemId",
            "params": [
              {
                "name": "dbSystemId",
                "value": "ocid1.resource.oc1.iad.abcdefg123456",
                "type": "path",
                "description": "The OCID of the DB system."
              }
            ]
          },
          "docs": "Gets the specified DB system."
        }
      ]
    }
  ],
  "bundled": true
}