{
  "opencollection": "1.0.0",
  "info": {
    "name": "Oracle Cloud Compute Alarms Shapes API",
    "version": "20160918"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Shapes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Oracle Cloud List Shapes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://iaas.{region}.oraclecloud.com/20160918/shapes",
            "params": [
              {
                "name": "compartmentId",
                "value": "ocid1.resource.oc1.iad.abcdefg123456",
                "type": "query",
                "description": "The OCID of the compartment."
              },
              {
                "name": "limit",
                "value": "1",
                "type": "query",
                "description": "Maximum number of items to return."
              },
              {
                "name": "page",
                "value": "example-value",
                "type": "query",
                "description": "Pagination token."
              }
            ]
          },
          "docs": "Lists the shapes that can be used to launch an instance within the specified compartment."
        }
      ]
    }
  ],
  "bundled": true
}